  "亚麻籽油":    { p: 0,    c: 0,    f: 100,  cal: 900 },
  "黄油":        { p: 0.5,  c: 0.5,  f: 81.0, cal: 740 },

  // 调料
  "生抽":        { p: 1.1,  c: 0.7,  f: 0,    cal: 8   },
  "醋":          { p: 0.1,  c: 0.5,  f: 0,    cal: 3   },
  "白醋":        { p: 0.1,  c: 0.5,  f: 0,    cal: 3   },
  "酱油":        { p: 1.1,  c: 0.7,  f: 0,    cal: 8   },
