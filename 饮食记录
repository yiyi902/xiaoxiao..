      </div>
      <div class="bar"><div class="bar-fill ok" style="width:0%"></div></div>
    </div>

    <div class="nutrient" data-key="calories">
      <div class="nutrient-header">
        <span>热量</span>
        <span><span class="val">0</span>kcal <span class="target">/ 1450-1550</span></span>
      </div>
      <div class="bar"><div class="bar-fill ok" style="width:0%"></div></div>
    </div>
  </div>

  <!-- 添加食物 -->
  <div class="card">
