};

// ========== 状态 ==========
const TODAY_KEY = 'diet_' + new Date().toISOString().slice(0, 10);
let records = JSON.parse(localStorage.getItem(TODAY_KEY) || '[]');

// ========== 初始化 ==========
document.getElementById('today').textContent = new Date().toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
});

// 填充食物库 datalist
const datalist = document.getElementById('foodLib');
Object.keys(FOOD_DB).forEach(name => {
  const opt = document.createElement('option');
  opt.value = name;
  datalist.appendChild(opt);
});

// ========== 添加食物 ==========
function addFood() {
  const nameInput = document.getElementById('foodName');
  const amountInput = document.getElementById('foodAmount');
  const mealType = document.getElementById('mealType').value;

  const name = nameInput.value.trim();
  const amount = parseFloat(amountInput.value);

  if (!name) { alert('请输入食物名称'); return; }
  if (!amount || amount <= 0) { alert('请输入有效克数'); return; }

  // 查找食物库（支持模糊匹配）
  let dbKey = Object.keys(FOOD_DB).find(k => k === name);
  if (!dbKey) {
    dbKey = Object.keys(FOOD_DB).find(k => k.includes(name) || name.includes(k));
  }

  if (!dbKey) {
    alert('食物库中未找到「' + name + '」，请换个名称试试');
    return;
  }

  const db = FOOD_DB[dbKey];
  const ratio = amount / 100;

  records.push({
    name: dbKey,
    amount: amount,
    mealType: mealType,
    p: +(db.p * ratio).toFixed(1),
    c: +(db.c * ratio).toFixed(1),
    f: +(db.f * ratio).toFixed(1),
    cal: Math.round(db.cal * ratio),
    time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })
  });

  save();
  render();

  // 清空输入
  nameInput.value = '';
  amountInput.value = 100;
  nameInput.focus();
}

// ========== 删除食物 ==========
function deleteFood(index) {
  if (!confirm('确定删除？')) return;
  records.splice(index, 1);
  save();
  render();
}

// ========== 清空今日 ==========
function clearToday() {
  if (!confirm('确定清空今日所有记录？')) return;
  records = [];
  save();
  render();
}

// ========== 保存到 localStorage ==========
function save() {
  localStorage.setItem(TODAY_KEY, JSON.stringify(records));
}

// ========== 渲染 ==========
function render() {
  // 汇总
  const total = records.reduce((acc, r) => ({
    p: acc.p + r.p,
    c: acc.c + r.c,
    f: acc.f + r.f,
    cal: acc.cal + r.cal
  }), { p: 0, c: 0, f: 0, cal: 0 });

  // 更新进度条
  updateBar('protein', total.p, 75, 90);
  updateBar('carbs', total.c, 140, 160);
  updateBar('fat', total.f, 40, 50);
  updateBar('calories', total.cal, 1450, 1550);

  // 渲染列表
  const list = document.getElementById('foodList');
  if (records.length === 0) {
    list.innerHTML = '<div class="empty">还没有记录，添加第一样食物吧</div>';
    return;
  }

  list.innerHTML = records.map((r, i) => `
    <div class="food-item">
      <div class="info">
        <div class="name">${r.mealType} · ${r.name} ${r.amount}g</div>
        <div class="meta">蛋白${r.p}g · 碳水${r.c}g · 脂肪${r.f}g · ${r.cal}kcal</div>
      </div>
      <button class="del" onclick="deleteFood(${i})">×</button>
    </div>
  `).join('');
}

// ========== 更新进度条 ==========
function updateBar(key, value, min, max) {
  const el = document.querySelector(`.nutrient[data-key="${key}"]`);
  if (!el) return;

  const valEl = el.querySelector('.val');
  const fillEl = el.querySelector('.bar-fill');

  valEl.textContent = Math.round(value);

  const pct = Math.min(100, (value / max) * 100);
  fillEl.style.width = pct + '%';

  // 颜色：低于下限=橙色，区间内=绿色，超过上限=红色
  fillEl.className = 'bar-fill ' + (
    value < min ? 'low' : value > max ? 'over' : 'ok'
  );
}

// ========== 导出数据 ==========
function exportData() {
  const total = records.reduce((acc, r) => ({
    p: acc.p + r.p, c: acc.c + r.c, f: acc.f + r.f, cal: acc.cal + r.cal
  }), { p: 0, c: 0, f: 0, cal: 0 });

  const text = `【饮食记录】${new Date().toLocaleDateString('zh-CN')}
──────────────────
${records.map(r => `${r.mealType} ${r.name} ${r.amount}g | 蛋白${r.p} 碳水${r.c} 脂肪${r.f} ${r.cal}kcal`).join('\n')}
──────────────────
合计：蛋白质${total.p.toFixed(1)}g / 碳水${total.c.toFixed(1)}g / 脂肪${total.f.toFixed(1)}g / 热量${total.cal}kcal`;

  navigator.clipboard.writeText(text).then(() => {
    alert('已复制到剪贴板！\n\n' + text);
  }).catch(() => {
    prompt('手动复制：', text);
  });
}

// ========== 启动 ==========
render();
</script>
</body>
</html>
